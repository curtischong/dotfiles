# syntax highlighting should be loaded after everything else that defines zle widgets
for _zsh_share in /opt/homebrew/share /usr/local/share /usr/share; do
  [ -f "$_zsh_share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && source "$_zsh_share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
done
unset _zsh_share
